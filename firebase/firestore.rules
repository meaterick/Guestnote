rules_version = '2';

// Guestnote Firestore 보안 규칙
//
// - 누구나 모든 날짜의 보드를 읽을 수 있어요. 글을 남기려면 Google 계정으로 로그인해야 해요.
// - 글은 '오늘' 보드에서만 남기고, 옮기고, 고치고, 지울 수 있어요. 지난 보드는 누구나 읽기만 해요. (관리자도 같아요)
//   오늘은 utcOffsetHours() 시간대의 날짜예요. public/config.js 의 timeZone 을 바꾸면 여기 값도 같이 바꿔 주세요. (한국 = 9)
// - 내 글은 오늘 안에서 옮기거나 고치거나 지울 수 있어요.
// - 관리자(admins/{uid} 문서가 있는 사람)는 오늘 보드의 남의 글도 옮기거나 지울 수 있어요.
// - 지난 글을 꼭 지워야 하면 Firebase 콘솔에서 지워요. (콘솔은 이 규칙을 거치지 않아요)
// - 보드 크기(4000 x 2600), 글자 수(이름 20자, 내용 500자), 사진 용량은 화면 코드와 맞춰 두었어요.

service cloud.firestore {
  match /databases/{database}/documents {

    function utcOffsetHours() {
      return 9;
    }

    // Google 계정으로 로그인한 사람만 써요. (익명 로그인 등 다른 방식은 막아요)
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 화면과 같이 계정 이름의 앞뒤 공백을 빼고 20자까지만 표시해요.
    function accountAuthor() {
      let raw = request.auth.token.get('name', '');
      let name = raw is string ? raw.trim() : '';
      return name.size() == 0 ? '방문자' : (name.size() > 20 ? name[0:20] : name);
    }

    function isDayKey(d) {
      return d is string && d.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    // 'YYYY-MM-DD' 가 지금 시각 기준으로 오늘인지 확인해요.
    function isToday(d) {
      let p = d.split('-');
      let local = request.time + duration.value(utcOffsetHours(), 'h');
      return isDayKey(d) && timestamp.date(int(p[0]), int(p[1]), int(p[2])) == local.date();
    }

    // 브라우저에서 줄인 사진만 받아요. (WebP 또는 JPEG 바이트)
    // 상한: 보드용 작은 사진 40,000바이트, 크게 보기용 사진 160,000바이트, 움직이는 GIF 320,000바이트
    // (public/config.js 의 예산보다 넉넉하게)
    function isImage(data, type, maxBytes) {
      return data is bytes && data.size() > 0 && data.size() <= maxBytes
        && type in ['image/webp', 'image/jpeg'];
    }

    function validImageFields(d) {
      return (!('img' in d) || (
          isImage(d.img, d.imgType, 40000)
          && d.imgW is int && d.imgW > 0 && d.imgW <= 2048
          && d.imgH is int && d.imgH > 0 && d.imgH <= 2048
          && d.imgFull is bool
          && (!('imgAnim' in d) || (d.imgAnim == true && d.imgFull == true))))
        && ('img' in d || (!('imgType' in d) && !('imgW' in d) && !('imgH' in d) && !('imgFull' in d) && !('imgAnim' in d)));
    }

    function validNote(d) {
      return d.keys().hasAll(['date', 'type', 'author', 'text', 'color', 'x', 'y', 'z', 'rot', 'ownerId', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['date', 'type', 'author', 'text', 'color', 'x', 'y', 'z', 'rot', 'ownerId', 'createdAt', 'updatedAt', 'img', 'imgType', 'imgW', 'imgH', 'imgFull', 'imgAnim'])
        && isDayKey(d.date)
        && d.type in ['text', 'memo']
        && d.author is string && d.author.size() >= 1 && d.author.size() <= 20 && d.author.matches('.*[^\\s].*')
        && d.text is string && d.text.size() <= 500
        && d.color in ['clear', 'sky', 'lilac', 'rose', 'peach', 'lemon', 'mint']
        && d.x is number && d.x >= 0 && d.x <= 4000
        && d.y is number && d.y >= 0 && d.y <= 2600
        && d.z is number && d.z >= 0 && d.z <= 1000000000
        && d.rot is number && d.rot >= -8 && d.rot <= 8
        && d.ownerId is string
        && d.createdAt is timestamp && d.updatedAt is timestamp
        && validImageFields(d)
        && (d.text.size() > 0 || 'img' in d);
    }

    match /notes/{noteId} {
      function unchanged(keys) {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
      }

      function onlyChanged(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }

      function mine() {
        return resource.data.ownerId == request.auth.uid;
      }

      allow read: if true;

      allow create: if signedIn()
        && validNote(request.resource.data)
        && request.resource.data.author == accountAuthor()
        && request.resource.data.ownerId == request.auth.uid
        && isToday(request.resource.data.date)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && isToday(resource.data.date)
        && validNote(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && unchanged(['date', 'ownerId', 'createdAt', 'author'])
        && (mine() || (isAdmin() && onlyChanged(['x', 'y', 'z', 'updatedAt'])));

      allow delete: if signedIn()
        && isToday(resource.data.date)
        && (mine() || isAdmin());
    }

    // 크게 보기용 사진. 같은 id의 글과 함께 저장하고 함께 지워요.
    match /images/{noteId} {
      function noteAfter() {
        return getAfter(/databases/$(database)/documents/notes/$(noteId)).data;
      }

      // 움직이는 GIF 글(imgAnim)에는 GIF만, 다른 글에는 WebP/JPEG만 받아요.
      function validImageDoc() {
        let d = request.resource.data;
        let animated = noteAfter().get('imgAnim', false) == true;
        return d.keys().hasAll(['data', 'type', 'ownerId', 'date'])
          && d.keys().hasOnly(['data', 'type', 'ownerId', 'date'])
          && d.ownerId == request.auth.uid
          && (animated
            ? (d.type == 'image/gif' && d.data is bytes && d.data.size() > 0 && d.data.size() <= 320000)
            : isImage(d.data, d.type, 160000))
          && isToday(d.date)
          && existsAfter(/databases/$(database)/documents/notes/$(noteId))
          && noteAfter().ownerId == request.auth.uid
          && noteAfter().date == d.date
          && noteAfter().imgFull == true;
      }

      allow read: if true;
      allow create: if signedIn() && validImageDoc();
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid && validImageDoc();
      allow delete: if signedIn()
        && (resource == null
          || (isToday(resource.data.date) && (resource.data.ownerId == request.auth.uid || isAdmin())));
    }

    // 관리자 목록은 Firebase 콘솔에서만 만들어요. 자기 문서만 확인할 수 있어요.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }
  }
}
